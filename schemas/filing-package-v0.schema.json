{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ubikia filing package v0",
  "type": "object",
  "required": [
    "schema",
    "id",
    "title",
    "source_root",
    "artifact",
    "sections"
  ],
  "properties": {
    "schema": {
      "const": "ubikia.filing-package.v0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "source_root": {
      "type": "string",
      "pattern": "\\S"
    },
    "source_clean_required": {
      "type": "boolean"
    },
    "artifact": {
      "type": "object",
      "required": [
        "filename"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.pdf$"
        }
      }
    },
    "release": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "title",
        "immutable_required"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "tag": {
          "type": "string",
          "pattern": "\\S"
        },
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "immutable_required": {
          "const": true
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "items"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "kind"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                },
                "kind": {
                  "enum": [
                    "markdown",
                    "pdf"
                  ]
                },
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "status": {
                  "enum": [
                    "ready",
                    "to_materialize",
                    "optional"
                  ]
                },
                "label": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
